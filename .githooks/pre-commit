#!/usr/bin/env bash
# Fast (<5s) checks on staged files only. Install: npm run hooks:install. Bypass: --no-verify.
# Written for bash 3.2 (macOS default): no mapfile.
set -euo pipefail
files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|json|css|yml|yaml)$' || true)"
[[ -z "${files}" ]] && exit 0
echo "${files}" | tr '\n' '\0' | xargs -0 npx prettier --check
lintable="$(echo "${files}" | grep -E '\.(ts|tsx|js)$' || true)"
[[ -n "${lintable}" ]] && echo "${lintable}" | tr '\n' '\0' | xargs -0 npx eslint --max-warnings 0
exit 0
