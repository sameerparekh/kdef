#!/usr/bin/env bash
# Pre-push (<30s): typecheck, lint, TODO and migration checks. Tests run in CI.
set -euo pipefail
npm run --silent typecheck
npm run --silent lint
.github/scripts/check-todos.sh
# Skip only when origin/main does not exist yet (the very first push of the repo).
if git fetch -q origin main 2>/dev/null; then
  .github/scripts/check-migrations.sh origin/main
fi
