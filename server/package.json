{
  "name": "@kdef/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=../.env src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/migrateCli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.0.2",
    "@kdef/shared": "*",
    "fastify": "^5.1.0",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
