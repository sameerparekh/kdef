# Used by `npm run dev -w server` outside Docker (after `npm run db:up`).
DATABASE_URL=postgres://kdef:kdef@localhost:55432/kdef
KDEF_DIR=/Volumes/brenn/KDEF
# Tests create throwaway databases here.
TEST_DATABASE_URL=postgres://kdef:kdef@localhost:55432/postgres
# Bind address and port for the server outside Docker (defaults: 0.0.0.0 = all interfaces, 8080).
# HOST=0.0.0.0
# PORT=8080
# Docker compose host publishing (defaults: all interfaces, 8080). Use KDEF_BIND=127.0.0.1 for this machine only.
# KDEF_BIND=0.0.0.0
# KDEF_PORT=8080
